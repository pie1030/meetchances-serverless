# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交。
# 部署到火山引擎时不要上传 .env —— 这些值在函数配置的「环境变量」里注入。

# 飞书应用凭证（开放平台 → 凭证与基础信息）
# 该应用需开通多维表格读写权限、已发布版本，并被加为目标表格的可编辑协作者
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here

# 目标多维表格（官网「联系我们」收集表）
# 取值见表格 URL：/base/<FEISHU_APP_TOKEN>?table=<FEISHU_TABLE_ID>
FEISHU_APP_TOKEN=your_bitable_app_token
FEISHU_TABLE_ID=your_table_id

# 群机器人 Webhook（群设置 → 群机器人 → 添加机器人 → 自定义机器人）
# 地址等同凭证，谁拿到都能往群里发消息，不要提交进仓库。
FEISHU_BOT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

FEISHU_BITABLE_VIEW_URL=https://example.feishu.cn/base/<app_token>?table=<table_id>&view=<view_id>

